; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Reference",
"class": "ColorMath",
"language": "GDScript",
"path": "res://libraries/math/ColorMath.gd"
}, {
"base": "Sprite",
"class": "LineBar",
"language": "GDScript",
"path": "res://libraries/ui/LineBar.gd"
}, {
"base": "TextureButton",
"class": "NavButton",
"language": "GDScript",
"path": "res://actors/ui/NavButton.gd"
}, {
"base": "Camera2D",
"class": "PCamera",
"language": "GDScript",
"path": "res://actors/pcamera/PCamera.gd"
}, {
"base": "Node",
"class": "UITree",
"language": "GDScript",
"path": "res://actors/ui/UITree.gd"
}, {
"base": "Control",
"class": "debugUI",
"language": "GDScript",
"path": "res://libraries/ui/debug/debugUI.gd"
}, {
"base": "Label",
"class": "showvariableUI",
"language": "GDScript",
"path": "res://libraries/ui/debug/showvariableUI.gd"
} ]
_global_script_class_icons={
"ColorMath": "",
"LineBar": "",
"NavButton": "",
"PCamera": "",
"UITree": "",
"debugUI": "",
"showvariableUI": ""
}

[application]

config/name="Object014 (Trace beta1)"
run/main_scene="res://Client.tscn"
config/icon="res://app/Icon512.png"

[autoload]

Options="*res://app/options.gd"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

environment/default_environment="res://default_env.tres"
